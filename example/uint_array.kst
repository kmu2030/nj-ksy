id: uint_array
data: uint_array.bin
asserts:
  - actual: array_1d.v[0]
    expected: 0
  - actual: array_1d.v[1]
    expected: 1
  - actual: array_1d.v[2]
    expected: 2

  - actual: array_2d.v[0].v[0]
    expected: 0
  - actual: array_2d.v[0].v[1]
    expected: 1
  - actual: array_2d.v[0].v[2]
    expected: 2
  - actual: array_2d.v[1].v[0]
    expected: 3
  - actual: array_2d.v[1].v[1]
    expected: 4
  - actual: array_2d.v[1].v[2]
    expected: 5
  - actual: array_2d.v[2].v[0]
    expected: 6
  - actual: array_2d.v[2].v[1]
    expected: 7
  - actual: array_2d.v[2].v[2]
    expected: 8

  - actual: array_3d.v[0].v[0].v[0]
    expected: 0
  - actual: array_3d.v[0].v[0].v[1]
    expected: 1
  - actual: array_3d.v[0].v[0].v[2]
    expected: 2
  - actual: array_3d.v[0].v[1].v[0]
    expected: 3
  - actual: array_3d.v[0].v[1].v[1]
    expected: 4
  - actual: array_3d.v[0].v[1].v[2]
    expected: 5
  - actual: array_3d.v[0].v[2].v[0]
    expected: 6
  - actual: array_3d.v[0].v[2].v[1]
    expected: 7
  - actual: array_3d.v[0].v[2].v[2]
    expected: 8
  - actual: array_3d.v[1].v[0].v[0]
    expected: 9
  - actual: array_3d.v[1].v[0].v[1]
    expected: 10
  - actual: array_3d.v[1].v[0].v[2]
    expected: 11
  - actual: array_3d.v[1].v[1].v[0]
    expected: 12
  - actual: array_3d.v[1].v[1].v[1]
    expected: 13
  - actual: array_3d.v[1].v[1].v[2]
    expected: 14
  - actual: array_3d.v[1].v[2].v[0]
    expected: 15
  - actual: array_3d.v[1].v[2].v[1]
    expected: 16
  - actual: array_3d.v[1].v[2].v[2]
    expected: 17
  - actual: array_3d.v[2].v[0].v[0]
    expected: 18
  - actual: array_3d.v[2].v[0].v[1]
    expected: 19
  - actual: array_3d.v[2].v[0].v[2]
    expected: 20
  - actual: array_3d.v[2].v[1].v[0]
    expected: 21
  - actual: array_3d.v[2].v[1].v[1]
    expected: 22
  - actual: array_3d.v[2].v[1].v[2]
    expected: 23
  - actual: array_3d.v[2].v[2].v[0]
    expected: 24
  - actual: array_3d.v[2].v[2].v[1]
    expected: 25
  - actual: array_3d.v[2].v[2].v[2]
    expected: 26
