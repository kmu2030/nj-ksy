id: struct_alignment1_arr_d1f
data: STRUCT_ALIGNMENT1_ARR_D1.bin
asserts:
  - actual: v.v[0].a_usint.v
    expected: 2
  - actual: v.v[0].a_sint.v
    expected: -1
  - actual: v.v[0].bytes.v[0]
    expected: 3
  - actual: v.v[0].bytes.v[1]
    expected: 4

  - actual: v.v[1].a_usint.v
    expected: 0
  - actual: v.v[1].a_sint.v
    expected: 0
  - actual: v.v[1].bytes.v[0]
    expected: 0
  - actual: v.v[1].bytes.v[1]
    expected: 0

  - actual: v.v[2].a_usint.v
    expected: 2
  - actual: v.v[2].a_sint.v
    expected: -1
  - actual: v.v[2].bytes.v[0]
    expected: 3
  - actual: v.v[2].bytes.v[1]
    expected: 4
